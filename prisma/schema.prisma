// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AlertaReserva {
  threadId          String    @id @map("thread_id")
  tipo              String?
  estado            EstadoOp  @default(PENDIENTE)
  fechaInicio       DateTime? @map("fecha_inicio")
  fechaUltimaAlerta DateTime? @map("fecha_ultima_alerta")
  fechaEmision      DateTime? @map("fecha_emision")
  asunto            String?
  cliente           String?
  cantidadAlertas   Int       @default(0) @map("cantidad_alertas")
  ultimoMensaje     BigInt?   @map("ultimo_mensaje")
  ultimaRevision    DateTime? @map("ultima_revision")
  fechaEvento       DateTime? @map("fecha_evento")
  estadoEvento      String?   @map("estado_evento")
  fechaAlertaEvento DateTime? @map("fecha_alerta_evento")
  fechaGestion      DateTime? @map("fecha_gestion")
  esAvianca         Boolean?  @default(false) @map("es_avianca")
  sheetRow          Int?      @unique @map("sheet_row")

  @@map("alerta_reservas")
}

model HiloPagoTotal {
  id             String   @id @default(cuid())
  threadId       String   @unique @map("thread_id")
  asunto         String
  cliente        String
  estado         EstadoPT @default(PENDIENTE)
  intencion      String?
  razon          String?
  ultimoMensaje  BigInt   @map("ultimo_mensaje")
  ultimaRevision DateTime @updatedAt @map("ultima_revision")
  creadoEn       DateTime @default(now()) @map("creado_en")
  syncSheet      Boolean  @default(false) @map("sync_sheet")

  @@map("hilos_pago_total")
}

// Tablas para la firmas de documentos
model Signature {
  signatureId String   @id @default(uuid()) @map("signature_id")
  name        String   @map("name")
  position    String?  @map("position")
  fileUrl     String?  @map("file_url")
  base64      String?  @map("base64")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("signatures")
}

model User {
  userId String @id @default(uuid()) @map("user_id")

  name               String     @map("name")
  email              String?    @unique @map("email")
  password           String?    @map("password")
  role               Role       @default(EMPLOYEE)
  status             UserStatus @default(ACTIVE)
  address            String?    @map("address")
  mustChangePassword Boolean    @default(true) @map("must_change_password")

  //Info laboral
  department String?   @map("department") // Tecnologia, RRHH
  position   String?   @map("position") // Auxiliar, etc
  area       String?   @map("area") // Comercial, Operaciones, etc
  startDate  DateTime? @map("start_date")

  // Identificación (solo dueño/ADMIN via serializer)
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @unique @map("document_number")

  // Ubicacion / contrato
  office       String?       @map("office") // Avenida, San antonio, Industrial
  contractType ContractType? @map("contract_type")
  legalEntity  String?       @map("legal_entity") // RAZÓN SOCIAL

  // seguridad social (sensible)
  eps String? @map("eps")
  afp String? @map("afp") // fondo de pensiones
  arl String? @map("arl") // riesgos laborales

  // salario (solo dueño/ADMIN)
  salary Decimal? @map("salary") @db.Decimal(12, 2)

  // contacto de emergencia
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyContactRel   String? @map("emergency_contact_rel") // parentesco del contacto de emergencia

  // Jerarquia
  leaderId  String? @map("leader_id") // a que lider reporta el emplead
  managerId String? @map("manager_id") // a que manager reporta el lider

  // Perfil
  avatarUrl String? @map("avatar_url")
  phone     String? @map("phone")

  // Autenticacion
  lastLoginAt  DateTime? @map("last_login_at")
  refreshToken String?   @map("refresh_token")

  // Invitación
  inviteToken   String?   @unique @map("invite_token")
  inviteExpires DateTime? @map("invite_expires")

  // Reset contraseña
  resetToken        String?   @unique @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")

  signatureId String? @map("signature_id")

  birthDate DateTime? @map("birth_date")

  // 2FA
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  temporyToken     String? @map("temporary_token")

  // feed
  canPublishInFeed Boolean @default(false)

  isLeader Boolean @default(false) @map("is_leader")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  signature Signature? @relation(fields: [signatureId], references: [signatureId])

  // Empleado -> lider
  leader      User?  @relation("EmployeeLeader", fields: [leaderId], references: [userId])
  teamMembers User[] @relation("EmployeeLeader")

  // Lider -> manager
  manager User?  @relation("LeaderManager", fields: [managerId], references: [userId])
  leaders User[] @relation("LeaderManager") // Lideres que reportan al manager

  formSubmissions FormSubmission[]

  // Puntos
  pointRequestsCreated   PointRequest[] @relation("UserPointRequests")
  pointRequestsToApprove PointRequest[] @relation("LeaderPointRequests")

  pointTransactions        PointTransaction[]
  pointWallet              PointWallet?
  notifications            Notification[]
  rewardRedemptions        RewardRedemption[]
  overtimeRequests         OvertimeRequest[]    @relation("EmployeeOvertime")
  overtimeRequestsToReview OvertimeRequest[]    @relation("LeaderOvertime")
  auditLogs                AuditLog[]
  googleCredentials        GoogleCredentials?
  leaveRequestsCreated     LeaveRequest[]       @relation("EmployeeLeave")
  leaveRequestsToApprove   LeaveRequest[]       @relation("LeaderLeave")
  recoveryCodes            RecoveryCode[]
  passwordVaults           PasswordVault[]
  passwordPermissions      PasswordPermission[]
  passwordAudits           PasswordAudit[]
  reactions                FeedReaction[]
  comments                 FeedComment[]
  recognizedPosts          FeedPost[]           @relation("RecognizedUser")
  feedPosts                FeedPost[]

  @@map("users")
}

model Template {
  templateId String   @id @default(uuid()) @map("template_id")
  name       String   @map("name")
  fileUrl    String?  @map("file_url")
  base64     String?  @map("base64")
  buffer     Bytes?   @map("buffer")
  fields     Json     @map("fields")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model Form {
  formId      String  @id @default(uuid()) @map("form_id")
  title       String  @map("title")
  description String? @map("description")
  category    String  @map("category") // RRHH, Tecnologia, etc
  type        String? @map("type") // EMBEDDED, NATIVE
  status      String? @map("status")

  // Para los formularios de google form
  embedUrl String? @map("embed_url")

  // Para los formularios nativos
  schema Json? @map("schema")

  // Autorellenar capos con datos del usuario
  autofill Json? @map("autofill")

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  submissions FormSubmission[]

  @@map("forms")
}

model FormSubmission {
  submissionId String   @id @default(uuid()) @map("submission_id")
  formId       String   @map("form_id")
  userId       String   @map("user_id")
  data         Json     @map("data") // respuesta del formulario
  status       String?  @map("status")
  createdAt    DateTime @default(now()) @map("created_at")

  form Form  @relation(fields: [formId], references: [formId])
  user User? @relation(fields: [userId], references: [userId])

  @@map("form_submissions")
}

// Modulo de puntos
model PointRequest {
  pointRequestId String @id @default(uuid()) @map("point_request_id")

  userId   String @map("user_id")
  leaderId String @map("leader_id")

  action String @map("action") // "Organizar actividad..."
  points Int    @map("points")

  status   PointRequestStatus @default(PENDING)
  decision String?            @map("decision") // Comentario del lider

  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")

  user   User @relation("UserPointRequests", fields: [userId], references: [userId])
  leader User @relation("LeaderPointRequests", fields: [leaderId], references: [userId])

  pointTransactions PointTransaction[]

  @@index([userId])
  @@index([leaderId])
  @@index([status])
  @@map("point_requests")
}

model PointTransaction {
  pointTransactionId String @id @default(uuid()) @map("point_transaction_id")

  userId         String  @map("user_id")
  pointRequestId String? @map("request_id")

  type   PointTransactionType @map("type") // EARN, REDEEM
  points Int                  @map("points")

  balanceAfter Int @map("balance_after") // Saldo despues de la transaccion

  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [userId])
  request PointRequest? @relation(fields: [pointRequestId], references: [pointRequestId])

  @@map("point_transactions")
}

model PointWallet {
  pointWalletId String @id @default(uuid()) @map("point_wallet_id")

  userId String @unique @map("user_id")
  total  Int    @default(0) @map("total")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("point_wallets")
}

// Notificaciones
model Notification {
  notificationId String @id @default(uuid()) @map("notification_id")

  userId  String @map("user_id")
  title   String @map("title")
  message String @map("message")

  type NotificationType @map("type")
  read Boolean          @default(false) @map("read")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("notifications")
}

// Premios
model Reward {
  rewardId String @id @default(uuid()) @map("reward_id")

  name        String  @map("name")
  description String? @map("description")
  cost        Int     @map("cost")

  type RewardType @default(MANUAL) @map("type")

  stock    Int?    @map("stock")
  isActive Boolean @default(true) @map("is_active")

  imageUrl String? @map("image_url")

  deliveryMethod  String? @map("delivery_method") // email, download
  deliveryContent Json?   @map("delivery_content") // URL de cupón, etc

  createdAt         DateTime           @default(now()) @map("created_at")
  rewardRedemptions RewardRedemption[]

  @@map("rewards")
}

model RewardRedemption {
  rewardRedemptionId String @id @default(uuid()) @map("reward_redemption_id")

  userId   String @map("user_id")
  rewardId String @map("reward_id")

  cost Int @map("cost")

  status RedemptionStatus @default(PENDING)

  processedBy String?   @map("processed_by") // userId de RRHH o sistema
  processedAt DateTime? @map("processed_at")

  rejectionReason String? @map("rejection_reason")

  deliveryDate DateTime? @map("delivery_date")

  createdAt  DateTime  @default(now()) @map("created_at")
  approvedAt DateTime? @map("approved_at")

  user   User   @relation(fields: [userId], references: [userId])
  reward Reward @relation(fields: [rewardId], references: [rewardId])

  @@map("reward_redemptions")
}

model OvertimeRequest {
  overtimeRequestId String @id @default(uuid()) @map("overtime_request_id")

  userId   String @map("user_id") // empleado 
  leaderId String @map("leader_id") // tomado de user.leaderId al momento de crear

  date       DateTime @map("date") @db.Date // solo la fecha, sin hora
  startTime  DateTime @map("start_time") // hora inicio
  endTime    DateTime @map("end_time") // hora fin
  totalHours Float    @map("total_hours") // calculado en el backend

  description String

  status  OvertimeStatus @default(PENDING)
  comment String?        @map("comment") // comentario del lider al rechazar (o aprobar)

  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")

  user   User @relation("EmployeeOvertime", fields: [userId], references: [userId])
  leader User @relation("LeaderOvertime", fields: [leaderId], references: [userId])

  @@index([userId])
  @@index([leaderId])
  @@index([status])
  @@index([date])
  @@map("overtime_requests")
}

model AuditLog {
  auditLogId String @id @default(uuid()) @map("audit_log_id")

  userId String? @map("user_id") // quien hizo la accion

  // que hizo
  action     AuditAction @map("action")
  entityType String      @map("entity_type") // "User" "PointRequest", "Reward" ...
  entityId   String      @map("entity_id") // ID del registro afectado

  // Detalle del cambio
  description String? @map("description") // detalle del cambio
  changes     Json?   @map("changes") // { before: {...}, after: {...} }
  metadata    Json?   @map("metadata") // contexto extra arbitrario

  // Contexto de la petición
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model GoogleCredentials {
  googleCredentialsId String @id @default(uuid()) @map("google_credentials_id")

  userId String @unique @map("user_id")

  accessToken  String @map("access_token")
  refreshToken String @map("refresh_token")

  expiryDate DateTime @map("expiry_date") // timestamp en milisegundos

  driveEnabled    Boolean @default(false) @map("drive_enabled")
  calendarEnabled Boolean @default(false) @map("calendar_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("google_credentials")
}

model LeaveRequest {
  leaveRequestId String @id @default(uuid()) @map("leave_request_id")

  userId   String @map("user_id")
  leaderId String @map("leader_id")

  type LeaveType @map("type")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  businessDays Int @map("business_days")

  reason String @map("reason") // motivo del empleado

  // para incapacidades/licencias que requieran soporte (PDF/imagen)
  attachmentUrl String? @map("attachment_url")

  status  LeaveStatus @default(PENDING)
  comment String?     @map("comment")

  createdAt  DateTime  @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")

  user   User @relation("EmployeeLeave", fields: [userId], references: [userId])
  leader User @relation("LeaderLeave", fields: [leaderId], references: [userId])

  @@index([userId])
  @@index([leaderId])
  @@index([status])
  @@index([type])
  @@index([startDate])
  @@map("leave_requests")
}

model RecoveryCode {
  recoveryCodeId String    @id @default(uuid()) @map("recovery_code_id")
  userId         String    @map("user_id")
  hash           String    @unique
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@index([userId, hash])
  @@map("recovery_code")
}

// PASSWORD VAULT
model PasswordVault {
  passwordVaultId   String                 @id @default(uuid()) @map("password_vault_id")
  title             String
  username          String?
  email             String?
  passwordEncrypted String                 @map("password_encrypted")
  passwordIv        String                 @map("password_iv")
  passwordAuthTag   String                 @map("password_auth_tag")
  passwordHash      String?                @map("password_hash")
  website           String?
  notes             String?
  categoryId        String?                @map("category_id")
  ownerId           String                 @map("owner_id")
  favorite          Boolean                @default(false)
  expiresAt         DateTime?              @map("expires_at")
  rotationDays      Int?                   @map("rotation_days")
  strengthLevel     PasswordStrengthLevel? @map("strength_level")

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [userId])

  category            PasswordCategory?    @relation(fields: [categoryId], references: [passwordCategoryId])
  permissions         PasswordPermission[]
  audits              PasswordAudit[]
  tags                PasswordTagOnVault[]
  passwordVersions    PasswordVersion[]
  passwordAttachments PasswordAttachment[]

  @@index([ownerId])
  @@index([categoryId])
  @@map("password_vault")
}

model PasswordCategory {
  passwordCategoryId String          @id @default(uuid()) @map("password_category_id")
  name               String
  color              String?
  icon               String?
  vaults             PasswordVault[]

  @@map("password_category")
}

model PasswordTag {
  passwordTagId String               @id @default(uuid()) @map("password_tag_id")
  name          String               @unique
  vaults        PasswordTagOnVault[]

  @@map("password_tags")
}

model PasswordTagOnVault {
  vaultId String @map("vault_id")
  tagId   String @map("tag_id")

  vault PasswordVault @relation(fields: [vaultId], references: [passwordVaultId])
  tag   PasswordTag   @relation(fields: [tagId], references: [passwordTagId])

  @@id([vaultId, tagId])
  @@map("passsword_tag_on_vault")
}

model PasswordPermission {
  passwordPermissionId String  @id @default(uuid()) @map("password_permission_id")
  vaultId              String  @map("vault_id")
  userId               String? @map("user_id")
  department           String? @map("department")
  canView              Boolean @default(true) @map("can_view")
  canEdit              Boolean @default(false) @map("can_edit")
  canDelete            Boolean @default(false) @map("can_delete")
  canAdmin             Boolean @default(false) @map("can_admin") // administrar

  vault PasswordVault @relation(fields: [vaultId], references: [passwordVaultId])
  user  User?         @relation(fields: [userId], references: [userId])

  @@index([vaultId])
  @@index([userId])
  @@index([department])
  @@map("password_permission")
}

model PasswordAudit {
  passwordAuditId String @id @default(uuid()) @map("password_audit_id")

  vaultId String              @map("vault_id")
  userId  String              @map("user_id")
  action  PasswordAuditAction

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now())

  vault PasswordVault @relation(fields: [vaultId], references: [passwordVaultId])
  user  User          @relation(fields: [userId], references: [userId])

  @@index([vaultId])
  @@index([userId])
  @@map("password_audit")
}

model PasswordVersion {
  passwordVersionId String @id @default(uuid()) @map("password_version_id")
  vaultId           String @map("vault_id")
  changedById       String @map("changed_by_id")
  versionNumber     Int    @map("version_number")

  passwordEncrypted String @map("password_encrypted")
  passwordIv        String @map("password_iv")
  passwordAuthTag   String @map("password_auth_tag")

  changedFields String[] @map("changed_fields") // ej: ["password", "username"]
  createdAt     DateTime @default(now()) @map("created_at")

  vault PasswordVault @relation(fields: [vaultId], references: [passwordVaultId])

  @@index([vaultId])
  @@map("password_version")
}

model PasswordAttachment {
  passwordAttachmentId String   @id @default(uuid()) @map("password_attachment_id")
  vaultId              String   @map("vault_id")
  fileName             String   @map("file_name")
  fileUrl              String   @map("file_url")
  fileType             String?  @map("file_type")
  fileSizeBytes        Int?     @map("file_size_bytes")
  uploadedById         String   @map("uploaded_by_id")
  createdAt            DateTime @default(now()) @map("created_at")

  vault PasswordVault @relation(fields: [vaultId], references: [passwordVaultId])

  @@index([vaultId])
  @@map("password_attachment")
}

/// Notificación HOTEL PAGO INMEDIATO
model HotelImmediatePayment {
  id                String    @id @default(cuid())
  threadId          String    @unique @map("thread_id")
  subject           String?
  notificationLevel Int       @default(0) @map("notification_level")
  answered          Boolean   @default(false)
  emailReceivedAt   DateTime  @map("email_received_at")
  lastNotifiedAt    DateTime? @map("last_notified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([answered, notificationLevel])
  @@map("hotel_immediate_payment")
}

// Feed
model FeedPost {
  feedPostId String       @id @default(uuid()) @map("feed_post_id")
  authorId   String       @map("author_id")
  author     User         @relation(fields: [authorId], references: [userId])
  type       FeedPostType @default(PUBLICATION)
  content    String
  images     String[]     @default([]) // urls por el momento
  pinned     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  deletedAt  DateTime?

  reactions FeedReaction[]
  comments  FeedComment[]

  // PARA RECONOCIMIENTS: A QUIEN SE RECONOCE
  recognizedUserId String? @map("recognized_user_id")
  recognizedUser   User?   @relation("RecognizedUser", fields: [recognizedUserId], references: [userId])

  @@index([createdAt])
  @@index([type])
  @@map("feed_post")
}

model FeedReaction {
  feedReactionId String       @id @default(uuid()) @map("feed_reaction_id")
  postId         String       @map("post_id")
  post           FeedPost     @relation(fields: [postId], references: [feedPostId], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [userId])
  type           ReactionType @default(LIKE)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([postId, userId]) // un usuario, una reaccion por post
  @@map("feed_reaction")
}

model FeedComment {
  feedCommentId String    @id @default(uuid()) @map("feed_comment_id")
  postId        String    @map("post_id")
  post          FeedPost  @relation(fields: [postId], references: [feedPostId], onDelete: Cascade)
  authorId      String    @map("author_id")
  author        User      @relation(fields: [authorId], references: [userId])
  content       String
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([postId])
  @@map("feed_comment")
}

// ENUMS
enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
}

enum FeedPostType {
  PUBLICATION // comunicado normal
  RECOGNITION // reconocimiento a un colaborador
  ANNOUNCEMENT // comunicado oficial de RRHH
}

enum RedemptionStatus {
  PENDING // Acaba de redimir, esperando procesamiento
  IN_PROCESS // RRHH lo vio, esta en proceso
  APPROVED // aprobado, listo para entregar
  COMPLETED // ya entregado/disponible
  REJECTED // rechazado por el lider, rrhh, etc
  CANCELLED // cancelado por el usuario
}

enum EstadoPT {
  PENDIENTE
  SOLICITUD
  CONFIRMADO
  DESCARTADO
  REVISION
}

enum EstadoOp {
  PENDIENTE
  ALERTA_ENVIADA
  EMITIDO
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  LEADER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum FormType {
  EMBEDDED
  NATIVE
}

enum FormStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum FormSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PointRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PointTransactionType {
  EARN
  REDEEM
}

enum NotificationType {
  POINT_REQUEST
  POINT_APPROVAL
  POINT_REJECTION
  REWARD_REDEMPTION
  REWARD_APPROVED
  REWARD_REJECTED
  REWARD_COMPLETED
  OVERTIME_REQUEST
  OVERTIME_APPROVED
  OVERTIME_REJECTED
  APPROVAL
  REJECTION
}

enum RewardType {
  AUTOMATIC // Cupones, netflix, etc
  MANUAL // Productos fisicos
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
