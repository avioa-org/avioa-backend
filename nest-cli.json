{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "infrastructure/offers-runtime/*.cjs",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "modules/offers-query/*.cjs",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "modules/offers-query/*.js",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "modules/offers-query/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "infrastructure/hunter-sync/*.cjs",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}
